
<!DOCTYPE html>
<html lang="ht">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>PHJoolens Store</title>

<style>

:root{
    --gold:#d99a16;
    --gold2:#efbd4b;
    --dark:#14213d;
    --gray:#687080;
    --white:#ffffff;
    --bg:#f7f8fa;
    --green:#25d366;
    --red:#e74c3c;
}

*{
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    margin:0;
    padding-bottom:90px;
    font-family:Segoe UI,Tahoma,Arial,sans-serif;
    background:var(--bg);
    color:#222;
}

/* ================= LOGIN ================= */

#login-modal{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.75);
    display:flex;
    align-items:center;
    justify-content:center;
    z-index:9999;
    padding:20px;
}

.login-box{
    background:white;
    width:100%;
    max-width:410px;
    padding:30px 24px;
    border-radius:20px;
    text-align:center;
    box-shadow:0 15px 50px rgba(0,0,0,.25);
}

.login-logo{
    font-size:42px;
    margin-bottom:5px;
}

.login-box h2{
    margin:5px 0 10px;
    color:var(--dark);
}

.login-box p{
    color:var(--gray);
    line-height:1.5;
}

.login-box input{
    width:100%;
    padding:14px;
    margin:10px 0;
    border:1px solid #ddd;
    border-radius:10px;
    font-size:16px;
    outline:none;
}

.login-box input:focus{
    border-color:var(--gold);
}

.login-box button{
    width:100%;
    padding:14px;
    border:0;
    border-radius:10px;
    background:linear-gradient(135deg,var(--gold),var(--gold2));
    color:white;
    font-weight:800;
    font-size:16px;
    cursor:pointer;
}

/* ================= HEADER ================= */

header{
    position:sticky;
    top:0;
    z-index:1000;
    background:white;
    padding:13px 15px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    box-shadow:0 2px 10px rgba(0,0,0,.08);
}

.logo{
    font-size:18px;
    font-weight:900;
    color:var(--dark);
}

.wallet{
    background:#fff4d6;
    color:#9a6b00;
    padding:8px 12px;
    border-radius:20px;
    font-weight:800;
    white-space:nowrap;
}

.logout{
    background:var(--red);
    color:white;
    border:0;
    padding:8px 11px;
    border-radius:8px;
    font-weight:700;
    cursor:pointer;
}

/* ================= MAIN ================= */

.container{
    width:100%;
    max-width:900px;
    margin:0 auto;
    padding:22px 15px;
}

.main-title{
    text-align:center;
    margin:5px 0;
    color:var(--dark);
    font-size:30px;
}

.subtitle{
    text-align:center;
    color:var(--gray);
    margin-bottom:20px;
}

/* ================= SERVICES ================= */

.service-title{
    font-size:18px;
    font-weight:900;
    color:var(--dark);
    margin-bottom:10px;
}

.tabs{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:9px;
    margin-bottom:18px;
}

.tab{
    border:1px solid #ddd;
    background:white;
    border-radius:12px;
    padding:10px 7px;
    cursor:pointer;
    font-weight:800;
    min-height:82px;
    transition:.2s;
}

.tab:hover{
    transform:translateY(-2px);
}

.tab.active{
    border:2px solid var(--gold);
    background:#fffaf0;
}

.tab img{
    width:42px;
    height:42px;
    object-fit:contain;
    display:block;
    margin:0 auto 5px;
}

.tab span{
    display:block;
    font-size:12px;
}

/* ================= PRODUCT ================= */

.head{
    background:white;
    border:1px solid #e5e5e5;
    border-radius:16px;
    padding:18px;
    margin-bottom:14px;
}

.product-top{
    display:flex;
    align-items:center;
    gap:15px;
}

.product-logo{
    width:65px;
    height:65px;
    object-fit:contain;
    flex-shrink:0;
}

.head h2{
    margin:0 0 7px;
    color:var(--dark);
}

.range{
    font-size:18px;
    font-weight:900;
    color:var(--gold);
}

.desc{
    color:#666;
    line-height:1.5;
    margin-top:10px;
}

/* ================= PACKAGES ================= */

.grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:10px;
}

.pkg{
    background:white;
    border:1px solid #d8d8d8;
    border-radius:11px;
    padding:13px 11px;
    text-align:left;
    font-weight:800;
    cursor:pointer;
    min-height:65px;
    transition:.2s;
}

.pkg:hover{
    border-color:var(--gold);
}

.pkg.active{
    border:2px solid var(--gold);
    background:#fff9eb;
}

.pkg small{
    display:block;
    color:#b27b00;
    margin-top:6px;
    font-size:14px;
}

/* ================= SELECTED ================= */

.selected{
    background:white;
    border:1px solid #e5e5e5;
    border-radius:13px;
    padding:15px;
    margin:15px 0;
    font-size:21px;
    font-weight:900;
    color:var(--dark);
    text-align:center;
}

/* ================= FORM ================= */

.form{
    background:white;
    border:1px solid #e3e3e3;
    border-radius:15px;
    padding:17px;
}

.badge{
    display:inline-block;
    background:#fff8df;
    border:1px solid #f0d88a;
    color:#8a6800;
    padding:7px 10px;
    border-radius:7px;
    font-size:13px;
    font-weight:800;
    margin-bottom:10px;
}

.form label{
    display:block;
    font-weight:800;
    margin:10px 0 6px;
}

.form input{
    width:100%;
    padding:13px;
    border:1px solid #ccc;
    border-radius:9px;
    font-size:16px;
    outline:none;
}

.form input:focus{
    border-color:var(--gold);
}

.hint{
    font-size:12px;
    color:#777;
    margin-top:5px;
}

/* ================= BUY ================= */

.buy{
    width:100%;
    margin-top:14px;
    padding:15px;
    border:0;
    border-radius:11px;
    background:linear-gradient(135deg,var(--gold),var(--gold2));
    color:white;
    font-weight:900;
    font-size:17px;
    cursor:pointer;
    box-shadow:0 5px 15px rgba(217,154,22,.25);
}

.buy:hover{
    opacity:.92;
}

/* ================= PAYMENT ================= */

.payment{
    background:#edf7ff;
    border-left:5px solid #2196f3;
    padding:17px;
    margin-top:20px;
    border-radius:10px;
}

.payment h3{
    margin-top:0;
    color:#145a85;
}

.payment p{
    margin:8px 0;
    font-size:14px;
}

.payment-number{
    font-size:16px;
    font-weight:900;
}

/* ================= ORDERS MODAL ================= */

#orders-modal{
    display:none;
    position:fixed;
    inset:0;
    z-index:5000;
    background:rgba(0,0,0,.7);
    padding:20px;
    overflow-y:auto;
}

.orders-box{
    background:white;
    max-width:650px;
    margin:40px auto;
    border-radius:18px;
    padding:20px;
}

.orders-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:10px;
}

.close-btn{
    border:0;
    background:#eee;
    width:38px;
    height:38px;
    border-radius:50%;
    font-size:20px;
    cursor:pointer;
}

.order-item{
    border:1px solid #ddd;
    border-radius:12px;
    padding:14px;
    margin-top:10px;
    background:#fafafa;
}

.order-item strong{
    color:var(--dark);
}

.no-orders{
    text-align:center;
    color:#777;
    padding:25px;
}

/* ================= NAV ================= */

.nav{
    position:fixed;
    bottom:0;
    left:0;
    width:100%;
    z-index:2000;
    background:white;
    display:flex;
    justify-content:space-around;
    padding:8px 2px;
    box-shadow:0 -3px 12px rgba(0,0,0,.10);
}

.nav a{
    text-decoration:none;
    color:#666;
    text-align:center;
    font-size:11px;
    min-width:60px;
}

.nav b{
    display:block;
    font-size:20px;
    margin-bottom:2px;
}

.nav a:hover{
    color:var(--gold);
}

/* ================= RESPONSIVE ================= */

@media(max-width:600px){

    .container{
        padding:18px 12px;
    }

    .main-title{
        font-size:25px;
    }

    .tabs{
        grid-template-columns:repeat(3,1fr);
        gap:7px;
    }

    .tab{
        min-height:75px;
        padding:7px 3px;
    }

    .tab img{
        width:36px;
        height:36px;
    }

    .tab span{
        font-size:10px;
    }

    .product-logo{
        width:55px;
        height:55px;
    }

    .grid{
        grid-template-columns:1fr 1fr;
    }

    .logo{
        font-size:14px;
    }

    .wallet{
        font-size:12px;
        padding:7px 9px;
    }

    .logout{
        font-size:11px;
        padding:7px 8px;
    }
}

</style>
</head>

<body>

<!-- ================= LOGIN ================= -->

<div id="login-modal">

    <div class="login-box">

        <div class="login-logo">⚡</div>

        <h2>PHJoolens Store</h2>

        <p>
            Antre adrès Gmail ou pou w ka konekte.
        </p>

        <input
            type="email"
            id="gmail-input"
            placeholder="egzanp@gmail.com"
        >

        <button onclick="konekte()">
            Konekte
        </button>

    </div>

</div>


<!-- ================= HEADER ================= -->

<header>

    <div class="logo">
        ⚡ PHJoolens Store
    </div>

    <div class="wallet">
        G 0.00
    </div>

    <button class="logout" onclick="soti()">
        Dekonekte
    </button>

</header>


<!-- ================= MAIN ================= -->

<div class="container">

    <h1 class="main-title">
        PHJoolens Store
    </h1>

    <div class="subtitle">
        Gaming • Diamonds • UC • Coins • Gift Cards
    </div>


    <div class="service-title">
        🎮 Chwazi sèvis ou
    </div>

    <div class="tabs" id="tabs"></div>


    <div id="product"></div>


    <!-- ================= PAYMENT ================= -->

    <div class="payment">

        <h3>
            💳 Enfòmasyon sou Peman
        </h3>

        <p>
            📲 <b>WhatsApp:</b>
            <span class="payment-number">
                +509 32 26 5636
            </span>
        </p>

        <p>
            💸 <b>MonCash / Nimewo transfè:</b>
            <span class="payment-number">
                +509 4882-8406
            </span>
        </p>

        <p>
            💰 <b>NatCash:</b>
            <span class="payment-number">
                +509 5607-9663
            </span>
        </p>

        <p>
            ⚠️ Antre nimewo ou te itilize pou fè transfè a
            anvan ou voye kòmand lan.
        </p>

    </div>

</div>


<!-- ================= ORDERS MODAL ================= -->

<div id="orders-modal">

    <div class="orders-box">

        <div class="orders-header">

            <h2>
                📋 Mes kòmand
            </h2>

            <button
                class="close-btn"
                onclick="closeOrders()"
            >
                ×
            </button>

        </div>

        <div id="orders-list"></div>

    </div>

</div>


<!-- ================= BOTTOM NAV ================= -->

<div class="nav">

    <a href="#" onclick="goHome()">
        <b>🏠</b>
        Accueil
    </a>

    <a href="#services" onclick="scrollServices()">
        <b>🛒</b>
        Services
    </a>

    <a href="#" onclick="showWallet()">
        <b>💳</b>
        Portefeuille
    </a>

    <a href="#" onclick="openOrdersModal()">
        <b>📋</b>
        Commandes
    </a>

    <a
        href="https://wa.me/50932265636"
        target="_blank"
    >
        <b>💬</b>
        Support
    </a>

</div>


<script>

/* =========================================================
   PHJOOLENS STORE
   SERVICES + PRICES + LOGOS
========================================================= */

const services = {

    freefire: {

        title:"Free Fire",

        logo:"logos/freefire.png",

        description:
        "Recharge Free Fire. Antre ID jwè a anvan kòmand lan.",

        input:"ID Jwè",

        placeholder:
        "Antre ID Free Fire ou",

        type:"player",

        packages:[

            ["110 Diamonds",150],
            ["220 Diamonds",300],
            ["341 Diamonds",450],
            ["572 Diamonds",750],
            ["682 Diamonds",900],
            ["792 Diamonds",1050],
            ["913 Diamonds",1350],
            ["1166 Diamonds",1500],
            ["2398 Diamonds",3000],
            ["3564 Diamonds",9300],
            ["Booyah Pass",500],
            ["Abonnement semaine",375],
            ["Abonnement mois",1650]

        ]

    },


    pubg: {

        title:"PUBG Mobile",

        logo:"logos/pubg.png",

        description:
        "Recharge PUBG Mobile UC. Antre ID jwè a anvan kòmand lan.",

        input:"ID Jwè",

        placeholder:
        "Antre ID PUBG Mobile ou",

        type:"player",

        packages:[

            ["60 UC",180],
            ["325 UC",875],
            ["660 UC",1600],
            ["1800 UC",3500],
            ["3850 UC",8000],
            ["8100 UC",16900],
            ["16200 UC",33000]

        ]

    },


    mobilelegends: {

        title:"Mobile Legends",

        logo:"logos/mobilelegends.png",

        description:
        "Recharge Mobile Legends Diamonds.",

        input:"ID Jwè",

        placeholder:
        "Antre ID Mobile Legends ou",

        type:"player",

        packages:[

            ["86 Diamonds",null],
            ["172 Diamonds",null],
            ["257 Diamonds",null],
            ["344 Diamonds",null],
            ["429 Diamonds",null],
            ["514 Diamonds",null],
            ["706 Diamonds",null],
            ["1412 Diamonds",null]

        ]

    },


    cod: {

        title:"Call of Duty Mobile",

        logo:"logos/callofduty.png",

        description:
        "Recharge Call of Duty Mobile CP.",

        input:"ID Jwè",

        placeholder:
        "Antre ID Call of Duty Mobile ou",

        type:"player",

        packages:[

            ["80 CP",null],
            ["420 CP",null],
            ["880 CP",null],
            ["2400 CP",null],
            ["5000 CP",null],
            ["10800 CP",null]

        ]

    },


    efootball: {

        title:"eFootball",

        logo:"logos/efootball.png",

        description:
        "Recharge eFootball Coins. Chwazi kantite Coins ou vle achte.",

        input:"ID Jwè",

        placeholder:
        "Antre ID eFootball ou",

        type:"player",

        packages:[

            ["1050 Coins",1950],
            ["2150 Coins",4000],
            ["3300 Coins",5900],
            ["5800 Coins",9850],
            ["12000 Coins",19700]

        ]

    },


    popolive: {

        title:"Popolive",

        logo:"logos/popolive.png",

        description:
        "Popolive Coins. Chwazi kantite Coins ou vle achte.",

        input:"ID / Username",

        placeholder:
        "Antre ID oswa Username Popolive ou",

        type:"player",

        packages:[

            ["9,900 Coins",350],
            ["19,800 Coins",650],
            ["29,700 Coins",1000],
            ["39,600 Coins",1350],
            ["49,500 Coins",1700],
            ["59,400 Coins",2000],
            ["69,300 Coins",2300],
            ["79,200 Coins",2600],
            ["89,100 Coins",2850],
            ["99,000 Coins",3150],
            ["108,900 Coins",3450],
            ["118,800 Coins",3700],
            ["128,700 Coins",4000],
            ["138,600 Coins",4300],
            ["148,500 Coins",4600],
            ["198,000 Coins",5700],
            ["247,500 Coins",6950],
            ["297,000 Coins",8150],
            ["346,500 Coins",9350],
            ["396,000 Coins",10600],
            ["445,500 Coins",11850],
            ["495,000 Coins",13050],
            ["594,000 Coins",15500],
            ["693,000 Coins",17950],
            ["792,000 Coins",20400],
            ["891,000 Coins",22850],
            ["990,000 Coins",25300],
            ["1,980,000 Coins",50600],
            ["2,970,000 Coins",75900],
            ["3,960,000 Coins",101200]

        ]

    },


    roblox: {

        title:"Roblox",

        logo:"logos/roblox.png",

        description:
        "Roblox Gift Card disponib. Chwazi valè ou vle achte.",

        input:"Username Roblox",

        placeholder:
        "Antre Username Roblox ou",

        type:"gift",

        packages:[

            ["$10 USD",1807],
            ["$20 USD",3614],
            ["$30 USD",5421],
            ["$40 USD",7228],
            ["$50 USD",9035],
            ["$60 USD",10842],
            ["$70 USD",12649],
            ["$80 USD",14456],
            ["$90 USD",16263],
            ["$100 USD",18070],
            ["$150 USD",27105],
            ["$200 USD",36140]

        ]

    },


    playstation: {

        title:"PlayStation Gift Card",

        logo:"logos/playstation.png",

        description:
        "PlayStation Gift Card. Pri ap vini.",

        input:"Email / Compte",

        placeholder:
        "Antre enfòmasyon nesesè",

        type:"gift",

        packages:[

            ["$10 USD",null],
            ["$20 USD",null],
            ["$50 USD",null],
            ["$100 USD",null]

        ]

    },


    googleplay: {

        title:"Google Play Gift Card",

        logo:"logos/googleplay.png",

        description:
        "Google Play Gift Card. Pri ap vini.",

        input:"Email / Compte",

        placeholder:
        "Antre enfòmasyon nesesè",

        type:"gift",

        packages:[

            ["$10 USD",null],
            ["$20 USD",null],
            ["$50 USD",null],
            ["$100 USD",null]

        ]

    }

};


/* =========================================================
   VARIABLES
========================================================= */

let currentService = "freefire";

let selectedPackage = 0;


/* =========================================================
   GET CURRENT GMAIL
========================================================= */

function getCurrentGmail(){

    return localStorage.getItem("phj_current_gmail");

}


/* =========================================================
   LOGIN
========================================================= */

function konekte(){

    const input =
        document.getElementById("gmail-input");

    const gmail =
        input.value.trim().toLowerCase();

    if(
        /^[^\s@]+@gmail\.com$/i.test(gmail)
    ){

        localStorage.setItem(
            "phj_current_gmail",
            gmail
        );

        document.getElementById(
            "login-modal"
        ).style.display = "none";

        renderPackages();

    }else{

        alert(
            "Tanpri antre yon adrès Gmail valab."
        );

    }

}


/* =========================================================
   LOGOUT
========================================================= */

function soti(){

    localStorage.removeItem(
        "phj_current_gmail"
    );

    location.reload();

}


/* =========================================================
   CHECK LOGIN
========================================================= */

function checkLogin(){

    const gmail =
        getCurrentGmail();

    if(!gmail){

        document.getElementById(
            "login-modal"
        ).style.display = "flex";

        return false;

    }

    return true;

}


/* =========================================================
   SERVICE TABS
========================================================= */

function renderTabs(){

    const tabs =
        document.getElementById("tabs");

    tabs.innerHTML = "";

    Object.keys(services).forEach(
        key => {

            const service =
                services[key];

            const button =
                document.createElement("button");

            button.className =
                "tab " +
                (
                    key === currentService
                    ? "active"
                    : ""
                );

            button.innerHTML = `

                <img
                    src="${service.logo}"
                    alt="${service.title}"
                >

                <span>
                    ${service.title}
                </span>

            `;

            button.onclick = function(){

                currentService = key;

                selectedPackage = 0;

                renderTabs();

                renderPackages();

            };

            tabs.appendChild(button);

        }
    );

}


/* =========================================================
   RENDER PRODUCTS
========================================================= */

function renderPackages(){

    const service =
        services[currentService];

    const product =
        document.getElementById("product");

    const prices =
        service.packages
        .map(item => item[1])
        .filter(price =>
            typeof price === "number"
        );

    let min = 0;
    let max = 0;

    if(prices.length){

        min = Math.min(...prices);
        max = Math.max(...prices);

    }

    const selected =
        service.packages[selectedPackage];

    let html = `

        <div class="head">

            <div class="product-top">

                <img
                    class="product-logo"
                    src="${service.logo}"
                    alt="${service.title}"
                >

                <div>

                    <h2>
                        ${service.title}
                    </h2>

                    ${
                        prices.length
                        ?
                        `<div class="range">
                            G ${min.toLocaleString()}
                            –
                            G ${max.toLocaleString()}
                        </div>`
                        :
                        `<div class="range">
                            Pri ap vini
                        </div>`
                    }

                </div>

            </div>

            <div class="desc">
                ${service.description}
            </div>

        </div>

        <div class="grid">

    `;


    service.packages.forEach(
        (item,index) => {

            const name = item[0];

            const price = item[1];

            html += `

                <button
                    class="pkg ${
                        index === selectedPackage
                        ? "active"
                        : ""
                    }"
                    onclick="pickPackage(${index})"
                >

                    ${name}

                    <small>

                        ${
                            price === null
                            ?
                            "Pri ap vini"
                            :
                            "G " +
                            price.toLocaleString() +
                            ".00"
                        }

                    </small>

                </button>

            `;

        }
    );


    html += `

        </div>

        <div class="selected">

            ${
                selected[1] === null
                ?
                "Pri chwazi: Pri ap vini"
                :
                "Pri chwazi: G " +
                selected[1].toLocaleString() +
                ".00"
            }

        </div>

        <div class="form">

            <span class="badge">
                ⚠️ Vérification requise
            </span>

    `;


    if(service.type === "player"){

        html += `

            <label>
                🆔 ${service.input}
            </label>

            <input
                id="service-info"
                type="text"
                placeholder="${service.placeholder}"
            >

            <div class="hint">
                Enfòmasyon sa nesesè pou trete recharge la.
            </div>

        `;

    }else{

        html += `

            <label>
                📧 ${service.input}
            </label>

            <input
                id="service-info"
                type="email"
                placeholder="${service.placeholder}"
            >

            <div class="hint">
                Mete email/compte ki nesesè pou Gift Card la.
            </div>

        `;

    }


    html += `

            <label>
                📱 Nimewo ou te fè transfè a
            </label>

            <input
                id="transfer"
                type="tel"
                placeholder="+509xxxxxxxx"
            >

            <div class="hint">
                Mete nimewo ki te itilize pou fè MonCash oswa NatCash la.
            </div>

        </div>

        <button
            class="buy"
            onclick="paseKomand()"
        >
            🛒 ACHETER MAINTENANT
        </button>

    `;


    product.innerHTML = html;

}


/* =========================================================
   SELECT PACKAGE
========================================================= */

function pickPackage(index){

    selectedPackage = index;

    renderPackages();

}


/* =========================================================
   SAVE ORDER
========================================================= */

function saveOrder(order){

    const gmail =
        getCurrentGmail();

    if(!gmail){
        return;
    }

    const key =
        "phj_commands_" + gmail;

    let orders =
        JSON.parse(
            localStorage.getItem(key) || "[]"
        );

    orders.unshift(order);

    localStorage.setItem(
        key,
        JSON.stringify(orders)
    );

}


/* =========================================================
   PLACE ORDER
========================================================= */

function paseKomand(){

    if(!checkLogin()){
        return;
    }

    const service =
        services[currentService];

    const packageData =
        service.packages[selectedPackage];

    const packageName =
        packageData[0];

    const price =
        packageData[1];

    if(price === null){

        alert(
            "Pri pou sèvis sa a poko disponib."
        );

        return;

    }


    const info =
        document
        .getElementById("service-info")
        .value
        .trim();


    const transfer =
        document
        .getElementById("transfer")
        .value
        .trim();


    if(!info){

        alert(
            "Tanpri antre enfòmasyon sèvis la."
        );

        return;

    }


    if(!transfer){

        alert(
            "Tanpri antre nimewo ou te itilize pou fè transfè a."
        );

        return;

    }


    const gmail =
        getCurrentGmail();


    const date =
        new Date().toLocaleString(
            "fr-FR"
        );


    const order = {

        id:
            Date.now(),

        service:
            service.title,

        package:
            packageName,

        price:
            price,

        info:
            info,

        transfer:
            transfer,

        gmail:
            gmail,

        date:
            date

    };


    saveOrder(order);


    const message =

`Salut PHJoolens Store! 👋

Mwen ta renmen pase yon kòmand.

🎮 Sèvis: ${service.title}

📦 Pakè: ${packageName}

💰 Pri: G ${price.toLocaleString()}.00

${service.type === "player"
? "🆔 ID / Info: "
: "📧 Email / Compte: "
}${info}

📱 Nimewo transfè: ${transfer}

📧 Gmail kont mwen: ${gmail}

🕐 Dat: ${date}

Mwen pare pou verifikasyon kòmand lan.`;



    const whatsappURL =
        "https://wa.me/50932265636?text=" +
        encodeURIComponent(message);


    window.open(
        whatsappURL,
        "_blank"
    );


    alert(
        "Kòmand lan anrejistre. WhatsApp ap louvri pou voye kòmand lan."
    );

}


/* =========================================================
   ORDERS MODAL
========================================================= */

function openOrdersModal(){

    if(!checkLogin()){
        return;
    }

    renderCommandsList();

    document.getElementById(
        "orders-modal"
    ).style.display = "block";

}


function closeOrders(){

    document.getElementById(
        "orders-modal"
    ).style.display = "none";

}


function renderCommandsList(){

    const gmail =
        getCurrentGmail();

    const list =
        document.getElementById(
            "orders-list"
        );

    const key =
        "phj_commands_" + gmail;

    const orders =
        JSON.parse(
            localStorage.getItem(key) || "[]"
        );


    if(!orders.length){

        list.innerHTML = `

            <div class="no-orders">

                📋
                <br><br>

                Ou poko gen okenn kòmand.

            </div>

        `;

        return;

    }


    list.innerHTML = "";


    orders.forEach(order => {

        const div =
            document.createElement("div");

        div.className =
            "order-item";


        div.innerHTML = `

            <strong>
                🎮 ${order.service}
            </strong>

            <br><br>

            📦
            <b>Pakè:</b>
            ${order.package}

            <br>

            💰
            <b>Pri:</b>
            G ${Number(order.price).toLocaleString()}.00

            <br>

            🆔
            <b>Info:</b>
            ${order.info}

            <br>

            📱
            <b>Transfè:</b>
            ${order.transfer}

            <br>

            📧
            <b>Gmail:</b>
            ${order.gmail}

            <br>

            🕐
            <b>Dat:</b>
            ${order.date}

        `;


        list.appendChild(div);

    });

}


/* =========================================================
   HOME
========================================================= */

function goHome(){

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });

}


/* =========================================================
   SERVICES SCROLL
========================================================= */

function scrollServices(){

    const tabs =
        document.getElementById("tabs");

    tabs.scrollIntoView({
        behavior:"smooth"
    });

}


/* =========================================================
   WALLET
========================================================= */

function showWallet(){

    if(!checkLogin()){
        return;
    }

    alert(
        "💳 Portefeuille PHJoolens Store\n\nSolde aktyèl: G 0.00"
    );

}


/* =========================================================
   CLOSE MODAL WHEN CLICKING OUTSIDE
========================================================= */

document
.getElementById("orders-modal")
.addEventListener(
    "click",
    function(event){

        if(
            event.target === this
        ){

            closeOrders();

        }

    }
);


/* =========================================================
   INITIALIZATION
========================================================= */

window.onload = function(){

    const gmail =
        getCurrentGmail();


    document.getElementById(
        "login-modal"
    ).style.display =
        gmail
        ? "none"
        : "flex";


    renderTabs();

    renderPackages();

};

</script>

</body>
</html>

